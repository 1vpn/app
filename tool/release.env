# The version label. The build number is not kept here: the release workflow
# derives it from the tag with tool/release/build-number.sh.
RELEASE_VERSION=3.0.2
# The upload certificate's SHA-256 fingerprint, public: 64 lowercase hex
# characters, no colons, as apksigner verify --print-certs prints it. The
# release workflow's sign job refuses a signer that differs, and refuses this
# line while it is empty.
UPLOAD_CERT_SHA256=17783652f591d2fa1bdf9c95861880bb65bfbb914934e708692e915c2207cfe7
# The Play app signing certificate's SHA-256 fingerprint, public: 64
# lowercase hex characters, no colons, as apksigner verify --print-certs
# prints it. A maintainer fills it from an APK Play delivered for this app.
# The release workflow's play job refuses a Play-signed APK whose signer
# differs, and refuses this line while it is empty.
PLAY_CERT_SHA256=52bc12d2143f8046670da810a147efcf2327aa9a42602227d4a03cc59d5c4069
