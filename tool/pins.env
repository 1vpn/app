# Toolchain and dependency pins — the single source of truth.
# The workflows source FLUTTER_VERSION, UPSTREAM_TAG and the libXray pins from
# this file. mise.toml mirrors the Flutter version for local tooling. The
# libxray workflow builds the aar from LIBXRAY_SHA with the toolchain pins below.
#
# GO_VERSION is the Go toolchain the aar builds with. It is at least the go
# directive in libXray's go.mod at LIBXRAY_SHA and carries the latest Go
# security release. The aar carries no geodata. The release build stages
# geoip.dat and geosite.dat from the prerelease
# geodata-<GEOIP_RELEASE>-<GEOSITE_RELEASE> and checks both against the
# pinned hashes below.
# XRAY_CORE_REF is the tagged release libXray pins at LIBXRAY_SHA. A bare commit needs a recorded reason.
FLUTTER_VERSION=3.47.1
# Pinned by SHA: upstream has cut no tag since v26.9.1. This commit is
# upstream's dev-26.9.3-2 head and becomes the 26.9.3 tag at upstream's cut;
# any residual delta lands as a follow-up bump then.
UPSTREAM_TAG=fb988b89c04e8411c0558ae0d2ee2b7c1ec3ba1f
LIBXRAY_SHA=dbe95129fa96689c4643ddca52c278448eec6df1
GO_VERSION=1.27.3
# The aar built at LIBXRAY_SHA. CI fetches it from the release libxray-<LIBXRAY_SHA:0:7>.
LIBXRAY_AAR_SHA256=e1e15cefbfe4187e29462dd41a5f5d98bf14a1d0565f8bdee396ce467b96db7a
# A release tag, or the full commit when libXray pins an untagged commit.
XRAY_CORE_REF=v26.10.21
# The x/mobile version that `go version -m` reports in the aar at LIBXRAY_AAR_SHA256.
LIBXRAY_GOMOBILE_VERSION=v0.0.0-20261011034528-197770444867
# The ndkVersion upstream pins in android/app/build.gradle.kts.
ANDROID_NDK_VERSION=29.0.14206865
# The v2fly/geoip release that publishes geoip.dat.
GEOIP_RELEASE=202608050239
# The v2fly/domain-list-community release that publishes dlc.dat, staged as geosite.dat.
GEOSITE_RELEASE=20260819144818
# The SHA-256 of geoip.dat that GitHub records for the asset at GEOIP_RELEASE.
GEOIP_SHA256=c67bd077eb102cec74fab759b73d17f99275f56af10a87c14d9fd983508f5ce1
# The SHA-256 of dlc.dat that GitHub records for the asset at GEOSITE_RELEASE.
GEOSITE_SHA256=f1fad85e66a838669b369f92ed0f02d14d67f8aa035d7d21df932906d50082e9
